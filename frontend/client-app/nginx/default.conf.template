map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# In a tenant this nginx sits behind the shared ingress-nginx controller, so
# the TCP peer is the controller pod, not the browser. Recover the real client
# from X-Forwarded-For, believing only private (pod/VPC/compose) hops and
# walking right to left so client-supplied entries are ignored. Without this
# every user reaches the gateway with the controller's IP and shares one
# rate-limit bucket.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 127.0.0.0/8;
set_real_ip_from ::1;
set_real_ip_from fc00::/7;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# The chain forwarded to the gateway: what this hop received plus its actual
# TCP peer ($realip_remote_addr), so the gateway can repeat the walk itself.
map $http_x_forwarded_for $forwarded_for_chain {
    ''      $realip_remote_addr;
    default "$http_x_forwarded_for, $realip_remote_addr";
}

server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /api/health {
        default_type application/json;
        return 200 '{"status":"healthy","service":"web-app"}';
    }

    # Proxy /api/v1/* to the API gateway (same-origin, no CORS), replacing the
    # old Next.js middleware rewrite. The full request path is passed through.
    location /api/v1/ {
        # nginx defaults to 1m, which 413s uploads here before they reach the
        # gateway. Match file-service's MAX_UPLOAD_BYTES (100 MB).
        client_max_body_size 100m;
        proxy_pass ${API_GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $forwarded_for_chain;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
