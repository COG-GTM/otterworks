# Local docker-compose configuration. Copy to .env (git-ignored) or run `make env`,
# which generates .env with a random password.
#
# Password for the local `otterworks` Postgres role, used by docker-compose.infra.yml
# and docker-compose.yml. Must be URL-safe (it is embedded in DSNs), e.g.:
#   openssl rand -hex 24
OTTERWORKS_DB_PASSWORD=
