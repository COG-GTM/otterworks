{
  "description": "REST contract scenarios replayed against legacy report-service and report-service-modern. Responses are normalized (ids, server-generated timestamps, file sizes) and must match the legacy golden transcript exactly.",
  "steps": [
    {"name": "health", "method": "GET", "path": "/health"},
    {"name": "create-pdf-iso-dates", "method": "POST", "path": "/api/v1/reports", "capture": "pdf",
     "json": {"reportName": "Parity PDF", "category": "USER_ACTIVITY", "reportType": "PDF", "requestedBy": "parity-user",
              "dateFrom": "2026-01-01T00:00:00Z", "dateTo": "2026-01-31T23:59:59.500+00:00", "parameters": {"region": "emea"}}},
    {"name": "create-csv-epoch-and-date-only", "method": "POST", "path": "/api/v1/reports", "capture": "csv",
     "json": {"reportName": "Parity CSV", "category": "STORAGE_SUMMARY", "reportType": "CSV", "requestedBy": "parity-user",
              "dateFrom": 1767225600000, "dateTo": "2026-02-01"}},
    {"name": "create-excel-default-dates", "method": "POST", "path": "/api/v1/reports", "capture": "xlsx", "maskDates": true,
     "json": {"reportName": "Parity Excel", "category": "USER_ACTIVITY", "reportType": "EXCEL", "requestedBy": "parity-user"}},
    {"name": "await-pdf", "method": "GET", "path": "/api/v1/reports/{pdf}", "awaitTerminal": true},
    {"name": "await-csv", "method": "GET", "path": "/api/v1/reports/{csv}", "awaitTerminal": true},
    {"name": "await-xlsx", "method": "GET", "path": "/api/v1/reports/{xlsx}", "awaitTerminal": true, "maskDates": true},
    {"name": "download-pdf", "method": "GET", "path": "/api/v1/reports/{pdf}/download"},
    {"name": "download-csv", "method": "GET", "path": "/api/v1/reports/{csv}/download"},
    {"name": "download-xlsx", "method": "GET", "path": "/api/v1/reports/{xlsx}/download"},
    {"name": "list-by-user", "method": "GET", "path": "/api/v1/reports?userId=parity-user", "maskDates": true},
    {"name": "list-by-user-unknown", "method": "GET", "path": "/api/v1/reports?userId=nobody"},
    {"name": "list-by-status-pending", "method": "GET", "path": "/api/v1/reports?status=PENDING"},
    {"name": "list-by-status-invalid", "method": "GET", "path": "/api/v1/reports?status=NOT_A_STATUS"},
    {"name": "create-missing-name", "method": "POST", "path": "/api/v1/reports",
     "json": {"category": "AUDIT_LOG", "reportType": "PDF", "requestedBy": "parity-user"}},
    {"name": "create-blank-requester", "method": "POST", "path": "/api/v1/reports",
     "json": {"reportName": "x", "category": "AUDIT_LOG", "reportType": "PDF", "requestedBy": "  "}},
    {"name": "create-missing-category", "method": "POST", "path": "/api/v1/reports",
     "json": {"reportName": "x", "reportType": "PDF", "requestedBy": "parity-user"}},
    {"name": "create-invalid-type", "method": "POST", "path": "/api/v1/reports",
     "json": {"reportName": "x", "category": "AUDIT_LOG", "reportType": "DOCX", "requestedBy": "parity-user"}},
    {"name": "create-invalid-date", "method": "POST", "path": "/api/v1/reports",
     "json": {"reportName": "x", "category": "AUDIT_LOG", "reportType": "PDF", "requestedBy": "parity-user", "dateFrom": "not-a-date"}},
    {"name": "create-malformed-json", "method": "POST", "path": "/api/v1/reports", "raw": "{\"reportName\": ", "contentType": "application/json"},
    {"name": "create-wrong-content-type", "method": "POST", "path": "/api/v1/reports", "raw": "reportName=x", "contentType": "text/plain"},
    {"name": "get-missing", "method": "GET", "path": "/api/v1/reports/999999"},
    {"name": "get-non-numeric-id", "method": "GET", "path": "/api/v1/reports/abc"},
    {"name": "download-missing", "method": "GET", "path": "/api/v1/reports/999999/download"},
    {"name": "delete-missing", "method": "DELETE", "path": "/api/v1/reports/999999"},
    {"name": "put-not-allowed", "method": "PUT", "path": "/api/v1/reports/{pdf}", "json": {}},
    {"name": "delete-pdf", "method": "DELETE", "path": "/api/v1/reports/{pdf}"},
    {"name": "get-deleted", "method": "GET", "path": "/api/v1/reports/{pdf}"},
    {"name": "download-deleted", "method": "GET", "path": "/api/v1/reports/{pdf}/download"},
    {"name": "delete-deleted", "method": "DELETE", "path": "/api/v1/reports/{pdf}"},
    {"name": "unknown-path", "method": "GET", "path": "/api/v1/unknown"}
  ]
}
