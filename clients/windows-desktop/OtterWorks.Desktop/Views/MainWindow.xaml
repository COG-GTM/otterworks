<Window x:Class="OtterWorks.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OtterWorks Desktop" Height="640" Width="960"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" Padding="20,0" Height="56"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="O" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="OtterWorks" Foreground="{StaticResource InkBrush}" FontSize="17"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="Desktop" Foreground="{StaticResource MutedBrush}" FontSize="17"
                               VerticalAlignment="Center" Margin="5,0,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="12,5"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center">
                            <Run Text="Signed in as" />
                            <Run Text="{Binding CurrentUserName, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{StaticResource InkBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentViewModel}" />
    </DockPanel>
</Window>
