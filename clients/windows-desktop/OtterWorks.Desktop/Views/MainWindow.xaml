<Window x:Class="OtterWorks.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OtterWorks Desktop" Height="640" Width="960"
        WindowStartupLocation="CenterScreen" Background="#F5F8FD" FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" Padding="18,12"
                BorderBrush="#DCE4F0" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OtterWorks" Foreground="#1E40AF" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Desktop" Foreground="#526581" FontSize="20" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Foreground="#526581" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Run Text="Signed in as " />
                        <Run Text="{Binding CurrentUserName, Mode=OneWay}" FontWeight="SemiBold" Foreground="#172B4D" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentViewModel}" />
    </DockPanel>
</Window>
