<UserControl x:Class="OtterWorks.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="White" CornerRadius="12" Padding="32,26" Width="400" Margin="0,20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.08" BlurRadius="24" ShadowDepth="4" Direction="270" />
            </Border.Effect>
            <StackPanel>
                <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Left" Margin="0,0,0,16">
                    <TextBlock Text="O" Foreground="White" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Sign in" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="Welcome back to OtterWorks." FontSize="14" Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,20" />

                <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBox}" />

                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource InputPasswordBox}"
                             PasswordChanged="PasswordInput_PasswordChanged" />

                <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,14,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                               FontSize="13" TextWrapping="Wrap" />
                </Border>

                <Button Content="Sign in" Style="{StaticResource PrimaryButton}" Height="42"
                        Command="{Binding LoginCommand}" Margin="0,20,0,0" IsDefault="True" />

                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" BorderThickness="0"
                             Foreground="{StaticResource AccentBrush}" Background="Transparent"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                        Margin="0,18,0,0" Padding="0,14,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="No account?" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                        <Button Content="Create one" Command="{Binding GoToRegisterCommand}"
                                Style="{StaticResource LinkButton}" FontSize="13" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
