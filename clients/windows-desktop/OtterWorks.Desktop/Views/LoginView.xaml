<UserControl x:Class="OtterWorks.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="12" Width="720" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#1F000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Brand panel -->
                <Border Grid.Column="0" Background="{StaticResource BrandGradientBrush}" CornerRadius="11,0,0,11"
                        Padding="32">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="8" Background="#33FFFFFF">
                                <TextBlock Text="O" Foreground="White" FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="OtterWorks" Foreground="White" FontSize="18" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="Documents and files, in sync across your team."
                                   Foreground="#DCE6FF" FontSize="13" TextWrapping="Wrap" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Your workspace," Foreground="White" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="on your desktop." Foreground="White" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Form -->
                <StackPanel Grid.Column="1" Margin="40,40,40,32">
                    <TextBlock Text="Sign in" FontSize="26" FontWeight="Bold" Foreground="#111827" />
                    <TextBlock Text="Welcome back to OtterWorks." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,24" />

                    <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}" />

                    <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#374151" Margin="0,16,0,6" />
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource InputPasswordBox}"
                                 PasswordChanged="PasswordInput_PasswordChanged" />

                    <Border Background="#FDECEC" CornerRadius="6" Padding="10,8" Margin="0,16,0,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Button Content="Sign in" Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoginCommand}" Margin="0,24,0,0" IsDefault="True" />

                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" BorderThickness="0"
                                 Foreground="{StaticResource AccentBrush}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="No account?" Foreground="{StaticResource MutedBrush}" />
                        <Button Content="Create one" Command="{Binding GoToRegisterCommand}"
                                Style="{StaticResource LinkButton}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
