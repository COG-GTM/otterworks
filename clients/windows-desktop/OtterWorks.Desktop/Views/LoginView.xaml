<UserControl x:Class="OtterWorks.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Foreground="#172B4D">
    <UserControl.Resources>
        <Style x:Key="SignInField" TargetType="Control">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#172B4D" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border Background="White" CornerRadius="12" Padding="32" Width="380"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#DCE4F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#172B4D" Opacity="0.08" BlurRadius="24" ShadowDepth="4" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Sign in" FontSize="26" FontWeight="SemiBold" Foreground="#172B4D" />
                <TextBlock Text="Welcome back to OtterWorks." Foreground="#526581" Margin="0,6,0,24" />

                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SignInField}" />

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,14,0,4" />
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource SignInField}"
                             PasswordChanged="PasswordInput_PasswordChanged" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

                <Button Content="Sign in" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}" Margin="0,24,0,0" Padding="14,10"
                        Background="#2563EB" IsDefault="True" />

                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" BorderThickness="0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock Text="No account?" Foreground="{StaticResource MutedBrush}" />
                    <Button Content="Create one" Command="{Binding GoToRegisterCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                            Cursor="Hand" Margin="6,0,0,0" Padding="0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
