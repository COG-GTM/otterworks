<UserControl x:Class="OtterWorks.Desktop.WinUI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="using:OtterWorks.Desktop.Mvvm">
    <Grid>
        <Border Style="{StaticResource Card}" Translation="0,0,16">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel>
                <TextBlock Text="Sign in" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeadingBrush}" />
                <TextBlock Text="Welcome back to OtterWorks." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20" />

                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" FontSize="14" />

                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordInput" Padding="8,6" FontSize="14"
                             PasswordChanged="PasswordInput_PasswordChanged" />

                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{x:Bind mvvm:Display.VisibleIfText(ViewModel.ErrorMessage), Mode=OneWay}" />

                <!-- The Enter accelerator stands in for WPF's IsDefault. -->
                <Button Content="Sign in" Style="{StaticResource PrimaryButton}"
                        Command="{x:Bind ViewModel.LoginCommand}" Margin="0,20,0,0">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" />
                    </Button.KeyboardAccelerators>
                </Button>

                <ProgressBar IsIndeterminate="True" MinHeight="3" Height="3" Margin="0,10,0,0"
                             Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock Text="No account?" Foreground="{StaticResource MutedBrush}" />
                    <Button Content="Create one" Style="{StaticResource LinkButton}"
                            Command="{x:Bind ViewModel.GoToRegisterCommand}" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
