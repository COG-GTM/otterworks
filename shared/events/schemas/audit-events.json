{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OtterWorks Audit Events",
  "definitions": {
    "EntityCreatedEvent": {
      "type": "object",
      "required": ["eventType", "auditId", "entityType", "entityId", "actorId", "timestamp"],
      "properties": {
        "eventType": { "const": "entity_created" },
        "auditId": { "type": "string", "format": "uuid" },
        "entityType": { "enum": ["document", "file", "folder", "user", "group"] },
        "entityId": { "type": "string", "format": "uuid" },
        "actorId": { "type": "string", "format": "uuid" },
        "metadata": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "EntityUpdatedEvent": {
      "type": "object",
      "required": ["eventType", "auditId", "entityType", "entityId", "actorId", "timestamp"],
      "properties": {
        "eventType": { "const": "entity_updated" },
        "auditId": { "type": "string", "format": "uuid" },
        "entityType": { "enum": ["document", "file", "folder", "user", "group"] },
        "entityId": { "type": "string", "format": "uuid" },
        "actorId": { "type": "string", "format": "uuid" },
        "changedFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "previousValues": { "type": "object" },
        "newValues": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "EntityDeletedEvent": {
      "type": "object",
      "required": ["eventType", "auditId", "entityType", "entityId", "actorId", "timestamp"],
      "properties": {
        "eventType": { "const": "entity_deleted" },
        "auditId": { "type": "string", "format": "uuid" },
        "entityType": { "enum": ["document", "file", "folder", "user", "group"] },
        "entityId": { "type": "string", "format": "uuid" },
        "actorId": { "type": "string", "format": "uuid" },
        "softDelete": { "type": "boolean", "default": true },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "AccessGrantedEvent": {
      "type": "object",
      "required": ["eventType", "auditId", "resourceId", "grantedTo", "permission", "grantedBy", "timestamp"],
      "properties": {
        "eventType": { "const": "access_granted" },
        "auditId": { "type": "string", "format": "uuid" },
        "resourceId": { "type": "string", "format": "uuid" },
        "resourceType": { "enum": ["document", "file", "folder"] },
        "grantedTo": { "type": "string", "format": "uuid" },
        "permission": { "enum": ["viewer", "editor", "admin"] },
        "grantedBy": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "AccessRevokedEvent": {
      "type": "object",
      "required": ["eventType", "auditId", "resourceId", "revokedFrom", "revokedBy", "timestamp"],
      "properties": {
        "eventType": { "const": "access_revoked" },
        "auditId": { "type": "string", "format": "uuid" },
        "resourceId": { "type": "string", "format": "uuid" },
        "resourceType": { "enum": ["document", "file", "folder"] },
        "revokedFrom": { "type": "string", "format": "uuid" },
        "revokedBy": { "type": "string", "format": "uuid" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "ShareAuditPayload": {
      "description": "Payload of the OTW-41 share audit events. Published by document-service's EventPublisher as {\"event_type\", \"timestamp\", \"payload\"}; keys are the snake_case keys audit-service's SnsConsumer reads from payload.",
      "type": "object",
      "required": [
        "user_id",
        "action",
        "resource_type",
        "resource_id",
        "workspace_id",
        "old_value",
        "new_value",
        "timestamp"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "description": "Actor user id (uuid), or \"system\" for detected expiry."
        },
        "action": {
          "enum": [
            "share_link_created",
            "share_link_expiry_changed",
            "share_link_expired",
            "workspace_share_policy_changed"
          ]
        },
        "resource_type": { "enum": ["folder", "workspace"] },
        "resource_id": { "type": "string" },
        "workspace_id": { "type": "string" },
        "old_value": { "type": ["object", "null"] },
        "new_value": { "type": ["object", "null"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ShareLinkCreatedEvent": {
      "type": "object",
      "required": ["event_type", "timestamp", "payload"],
      "properties": {
        "event_type": { "const": "share_link_created" },
        "timestamp": { "type": "string", "format": "date-time" },
        "payload": {
          "allOf": [
            { "$ref": "#/definitions/ShareAuditPayload" },
            {
              "properties": {
                "action": { "const": "share_link_created" },
                "resource_type": { "const": "folder" },
                "old_value": { "type": "null" },
                "new_value": {
                  "type": "object",
                  "required": ["expires_at"],
                  "properties": { "expires_at": { "type": "string", "format": "date-time" } },
                  "additionalProperties": false
                },
                "details": { "required": ["share_link_id"] }
              }
            }
          ]
        }
      }
    },
    "ShareLinkExpiryChangedEvent": {
      "type": "object",
      "required": ["event_type", "timestamp", "payload"],
      "properties": {
        "event_type": { "const": "share_link_expiry_changed" },
        "timestamp": { "type": "string", "format": "date-time" },
        "payload": {
          "allOf": [
            { "$ref": "#/definitions/ShareAuditPayload" },
            {
              "properties": {
                "action": { "const": "share_link_expiry_changed" },
                "resource_type": { "const": "folder" },
                "old_value": {
                  "type": "object",
                  "required": ["expires_at"],
                  "properties": { "expires_at": { "type": "string", "format": "date-time" } },
                  "additionalProperties": false
                },
                "new_value": {
                  "type": "object",
                  "required": ["expires_at"],
                  "properties": { "expires_at": { "type": "string", "format": "date-time" } },
                  "additionalProperties": false
                },
                "details": { "required": ["share_link_id"] }
              }
            }
          ]
        }
      }
    },
    "ShareLinkExpiredEvent": {
      "type": "object",
      "required": ["event_type", "timestamp", "payload"],
      "properties": {
        "event_type": { "const": "share_link_expired" },
        "timestamp": { "type": "string", "format": "date-time" },
        "payload": {
          "allOf": [
            { "$ref": "#/definitions/ShareAuditPayload" },
            {
              "properties": {
                "action": { "const": "share_link_expired" },
                "user_id": { "const": "system" },
                "resource_type": { "const": "folder" },
                "old_value": {
                  "type": "object",
                  "required": ["expires_at"],
                  "properties": { "expires_at": { "type": "string", "format": "date-time" } },
                  "additionalProperties": false
                },
                "new_value": {
                  "type": "object",
                  "required": ["expired_at"],
                  "properties": { "expired_at": { "type": "string", "format": "date-time" } },
                  "additionalProperties": false
                },
                "details": { "required": ["share_link_id"] }
              }
            }
          ]
        }
      }
    },
    "WorkspaceSharePolicyChangedEvent": {
      "type": "object",
      "required": ["event_type", "timestamp", "payload"],
      "properties": {
        "event_type": { "const": "workspace_share_policy_changed" },
        "timestamp": { "type": "string", "format": "date-time" },
        "payload": {
          "allOf": [
            { "$ref": "#/definitions/ShareAuditPayload" },
            {
              "properties": {
                "action": { "const": "workspace_share_policy_changed" },
                "resource_type": { "const": "workspace" },
                "old_value": {
                  "type": "object",
                  "required": ["default_days", "max_days"],
                  "properties": {
                    "default_days": { "type": "integer", "minimum": 1, "maximum": 90 },
                    "max_days": { "type": "integer", "minimum": 1, "maximum": 90 }
                  },
                  "additionalProperties": false
                },
                "new_value": {
                  "type": "object",
                  "required": ["default_days", "max_days"],
                  "properties": {
                    "default_days": { "type": "integer", "minimum": 1, "maximum": 90 },
                    "max_days": { "type": "integer", "minimum": 1, "maximum": 90 }
                  },
                  "additionalProperties": false
                }
              }
            }
          ]
        }
      }
    }
  }
}
