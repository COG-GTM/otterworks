{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OtterWorks Audit Events",
  "definitions": {
    "EntityCreatedEvent": {
      "type": "object",
      "required": ["eventType", "auditId", "entityType", "entityId", "actorId", "timestamp"],
      "properties": {
        "eventType": { "const": "entity_created" },
        "auditId": { "type": "string", "format": "uuid" },
        "entityType": { "enum": ["document", "file", "folder", "user", "group"] },
        "entityId": { "type": "string", "format": "uuid" },
        "actorId": { "type": "string", "format": "uuid" },
        "metadata": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "EntityUpdatedEvent": {
      "type": "object",
      "required": ["eventType", "auditId", "entityType", "entityId", "actorId", "timestamp"],
      "properties": {
        "eventType": { "const": "entity_updated" },
        "auditId": { "type": "string", "format": "uuid" },
        "entityType": { "enum": ["document", "file", "folder", "user", "group"] },
        "entityId": { "type": "string", "format": "uuid" },
        "actorId": { "type": "string", "format": "uuid" },
        "changedFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "previousValues": { "type": "object" },
        "newValues": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "EntityDeletedEvent": {
      "type": "object",
      "required": ["eventType", "auditId", "entityType", "entityId", "actorId", "timestamp"],
      "properties": {
        "eventType": { "const": "entity_deleted" },
        "auditId": { "type": "string", "format": "uuid" },
        "entityType": { "enum": ["document", "file", "folder", "user", "group"] },
        "entityId": { "type": "string", "format": "uuid" },
        "actorId": { "type": "string", "format": "uuid" },
        "softDelete": { "type": "boolean", "default": true },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "AccessGrantedEvent": {
      "type": "object",
      "required": ["eventType", "auditId", "resourceId", "grantedTo", "permission", "grantedBy", "timestamp"],
      "properties": {
        "eventType": { "const": "access_granted" },
        "auditId": { "type": "string", "format": "uuid" },
        "resourceId": { "type": "string", "format": "uuid" },
        "resourceType": { "enum": ["document", "file", "folder"] },
        "grantedTo": { "type": "string", "format": "uuid" },
        "permission": { "enum": ["viewer", "editor", "admin"] },
        "grantedBy": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "AccessRevokedEvent": {
      "type": "object",
      "required": ["eventType", "auditId", "resourceId", "revokedFrom", "revokedBy", "timestamp"],
      "properties": {
        "eventType": { "const": "access_revoked" },
        "auditId": { "type": "string", "format": "uuid" },
        "resourceId": { "type": "string", "format": "uuid" },
        "resourceType": { "enum": ["document", "file", "folder"] },
        "revokedFrom": { "type": "string", "format": "uuid" },
        "revokedBy": { "type": "string", "format": "uuid" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
    "ShareLinkAuditEvent": {
      "type": "object",
      "description": "Share-link lifecycle audit event published by document-service (OTW-20), in the flat shape audit-service consumes.",
      "required": ["eventType", "userId", "action", "resourceType", "resourceId", "details", "timestamp"],
      "properties": {
        "eventType": { "const": "share_link_audit" },
        "userId": { "type": "string", "description": "Actor user id, or \"system\" for expiry" },
        "action": { "enum": ["share_link_create", "share_link_expiry_change", "share_link_expire", "share_policy_update"] },
        "resourceType": { "enum": ["share_link", "workspace"] },
        "resourceId": { "type": "string" },
        "details": {
          "type": "object",
          "required": ["workspace", "oldValue", "newValue"],
          "properties": {
            "workspace": { "type": "string" },
            "oldValue": { "type": "string" },
            "newValue": { "type": "string" },
            "document_id": { "type": "string" },
            "expires_at": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": { "type": "string" }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
}
