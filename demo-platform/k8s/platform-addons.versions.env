# Pinned versions of the SHARED, cluster-wide platform add-ons (installed once
# per cluster, never per tenant). Single source of truth for:
#   scripts/lib/ingress-nginx.sh            (ingress-nginx)
#   demo-platform/scripts/install-cert-manager.sh
#   demo-platform/scripts/install-argocd.sh
#   platform/terraform/modules/platform-addons (helm_release, parses this file)
#   demo-platform/k8s/dns-tls/external-dns.yaml (image tag, checked by
#   scripts/check-image-drift.sh)
# Bump here, in a PR. Plain KEY="value" lines only: Terraform reads it with a regex.
INGRESS_NGINX_CHART_VERSION="4.15.1"
CERT_MANAGER_CHART_VERSION="v1.21.2"
EXTERNAL_DNS_CHART_VERSION="1.15.0"
EXTERNAL_DNS_VERSION="v0.15.0"
ARGOCD_CHART_VERSION="10.10.3"
