{
  "context": "announcements",
  "description": "Bean validation and body parsing failures return Boot's default 400 body; field limits accept exactly the maximum length.",
  "scenario": "announcements_validation",
  "steps": [
    {
      "name": "empty object",
      "request": {
        "json": {},
        "method": "POST",
        "path": "/api/announcements"
      },
      "response": {
        "body": {
          "error": "Bad Request",
          "path": "/api/announcements",
          "status": 400,
          "timestamp": "<instant:+00:00>"
        },
        "content_type": "application/json",
        "status": 400
      }
    },
    {
      "name": "blank title",
      "request": {
        "json": {
          "body": "text",
          "title": "   "
        },
        "method": "POST",
        "path": "/api/announcements"
      },
      "response": {
        "body": {
          "error": "Bad Request",
          "path": "/api/announcements",
          "status": 400,
          "timestamp": "<instant:+00:00>"
        },
        "content_type": "application/json",
        "status": 400
      }
    },
    {
      "name": "missing body",
      "request": {
        "json": {
          "title": "No body"
        },
        "method": "POST",
        "path": "/api/announcements"
      },
      "response": {
        "body": {
          "error": "Bad Request",
          "path": "/api/announcements",
          "status": 400,
          "timestamp": "<instant:+00:00>"
        },
        "content_type": "application/json",
        "status": 400
      }
    },
    {
      "name": "title over 200 chars",
      "request": {
        "json": {
          "body": "text",
          "title": "ttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"
        },
        "method": "POST",
        "path": "/api/announcements"
      },
      "response": {
        "body": {
          "error": "Bad Request",
          "path": "/api/announcements",
          "status": 400,
          "timestamp": "<instant:+00:00>"
        },
        "content_type": "application/json",
        "status": 400
      }
    },
    {
      "name": "body over 4000 chars",
      "request": {
        "json": {
          "body": "",
          "title": "Long body"
        },
        "method": "POST",
        "path": "/api/announcements"
      },
      "response": {
        "body": {
          "error": "Bad Request",
          "path": "/api/announcements",
          "status": 400,
          "timestamp": "<instant:+00:00>"
        },
        "content_type": "application/json",
        "status": 400
      }
    },
    {
      "name": "published not a boolean",
      "request": {
        "json": {
          "body": "y",
          "published": "yes",
          "title": "x"
        },
        "method": "POST",
        "path": "/api/announcements"
      },
      "response": {
        "body": {
          "error": "Bad Request",
          "path": "/api/announcements",
          "status": 400,
          "timestamp": "<instant:+00:00>"
        },
        "content_type": "application/json",
        "status": 400
      }
    },
    {
      "name": "malformed json",
      "request": {
        "content_type": "application/json",
        "method": "POST",
        "path": "/api/announcements",
        "raw": "{\"title\": \"unterminated"
      },
      "response": {
        "body": {
          "error": "Bad Request",
          "path": "/api/announcements",
          "status": 400,
          "timestamp": "<instant:+00:00>"
        },
        "content_type": "application/json",
        "status": 400
      }
    },
    {
      "name": "no request body",
      "request": {
        "content_type": "application/json",
        "method": "POST",
        "path": "/api/announcements"
      },
      "response": {
        "body": {
          "error": "Bad Request",
          "path": "/api/announcements",
          "status": 400,
          "timestamp": "<instant:+00:00>"
        },
        "content_type": "application/json",
        "status": 400
      }
    },
    {
      "name": "unsupported content type",
      "request": {
        "content_type": "text/plain",
        "method": "POST",
        "path": "/api/announcements",
        "raw": "title=x&body=y"
      },
      "response": {
        "body": {
          "error": "Unsupported Media Type",
          "path": "/api/announcements",
          "status": 415,
          "timestamp": "<instant:+00:00>"
        },
        "content_type": "application/json",
        "status": 415
      }
    },
    {
      "name": "title and body at maximum length",
      "request": {
        "json": {
          "body": "",
          "title": "tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"
        },
        "method": "POST",
        "path": "/api/announcements"
      },
      "response": {
        "body": {
          "body": "",
          "createdAt": "<instant:Z>",
          "id": "<id#1>",
          "published": false,
          "title": "tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"
        },
        "content_type": "application/json",
        "status": 201
      }
    }
  ]
}
