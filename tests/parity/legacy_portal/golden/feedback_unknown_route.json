{
  "context": "feedback",
  "description": "Unmapped paths fall through to Boot's default 404 body.",
  "scenario": "feedback_unknown_route",
  "steps": [
    {
      "name": "unknown api path",
      "request": {
        "method": "GET",
        "path": "/api/does-not-exist"
      },
      "response": {
        "body": {
          "error": "Not Found",
          "path": "/api/does-not-exist",
          "status": 404,
          "timestamp": "<instant:+00:00>"
        },
        "content_type": "application/json",
        "status": 404
      }
    },
    {
      "name": "unknown root path",
      "request": {
        "method": "GET",
        "path": "/nope"
      },
      "response": {
        "body": {
          "error": "Not Found",
          "path": "/nope",
          "status": 404,
          "timestamp": "<instant:+00:00>"
        },
        "content_type": "application/json",
        "status": 404
      }
    }
  ]
}
