# Copy to etl/airflow/.env (git-ignored) and replace every __SET_ME__ placeholder.
# Every secret reaches Airflow as a Connection (AIRFLOW_CONN_*) or a Variable (AIRFLOW_VAR_*);
# nothing is read from etl/config.ini. In a real deployment these come from a secrets backend
# (e.g. AWS Secrets Manager) instead of env vars; the connection ids stay the same.

# --- Airflow runner itself -------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=__SET_ME__
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=__SET_ME__
# 32 url-safe base64 bytes: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=__SET_ME__
AIRFLOW__WEBSERVER__SECRET_KEY=__SET_ME__

# --- Connections (ids are fixed in dags/otterworks_etl/settings.py) -------------------------
# aws_default -> LocalStack from docker-compose.infra.yml. LocalStack accepts any key pair.
AIRFLOW_CONN_AWS_DEFAULT='{"conn_type": "aws", "login": "__SET_ME__", "password": "__SET_ME__", "extra": {"region_name": "us-east-1", "endpoint_url": "http://otterworks-localstack:4566", "config_kwargs": {"s3": {"addressing_style": "path"}}}}'
# otterworks_postgres -> the infra Postgres (analytics_daily_summary lives here).
AIRFLOW_CONN_OTTERWORKS_POSTGRES='{"conn_type": "postgres", "host": "otterworks-postgres", "port": 5432, "schema": "otterworks", "login": "otterworks", "password": "__SET_ME__"}'
# otterworks_meilisearch -> password is the MeiliSearch API key (leave empty in MEILI_ENV=development).
AIRFLOW_CONN_OTTERWORKS_MEILISEARCH='{"conn_type": "http", "host": "otterworks-meilisearch", "port": 7700, "schema": "http", "password": ""}'
AIRFLOW_CONN_OTTERWORKS_DOCUMENT_SERVICE='{"conn_type": "http", "host": "document-service", "port": 8083, "schema": "http"}'
AIRFLOW_CONN_OTTERWORKS_FILE_SERVICE='{"conn_type": "http", "host": "file-service", "port": 8082, "schema": "http"}'
# spark_default -> spark-submit in local mode inside the Airflow container.
AIRFLOW_CONN_SPARK_DEFAULT='{"conn_type": "spark", "host": "local[*]"}'
# Optional failure alerting; leave unset for a no-op. password = webhook path.
# AIRFLOW_CONN_OTTERWORKS_SLACK_WEBHOOK='{"conn_type": "http", "host": "hooks.slack.com", "schema": "https", "password": "/services/__SET_ME__"}'

# --- Variable: non-secret config, merged over settings.DEFAULTS -------------------------
AIRFLOW_VAR_OTTERWORKS_ETL='{"file_storage_bucket": "otterworks-file-storage", "storage_cleanup_dry_run": false, "alert_emails": []}'
